# cp .env.example .env — only needed if the defaults don't fit.
# Default: panel talks to host.docker.internal:8080 (NInfer on the host).
# If NInfer is another container on the same Docker network, use its
# service name, e.g. NINFER_BASE_URL=http://ninfer:8080
NINFER_BASE_URL=http://host.docker.internal:8080
# Only if your NInfer was started with an API key; otherwise leave empty.
NINFER_API_KEY=
# Optional: real per-request rows from NInfer's request log. Start NInfer
# with --request-log-jsonl <file>, mount the file read-only into the panel
# container (see docker-compose.yml) and point this at the mounted path.
# PANEL_REQUEST_LOG=/app/request-log.jsonl
